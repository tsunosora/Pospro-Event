<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<title>Slip Gaji — {{worker.name}}</title>
<style>
  @page { size: A4; margin: 14mm 14mm; }
  * { box-sizing: border-box; }
  body { font-family: 'Arial', 'Helvetica', sans-serif; color: #000; font-size: 10pt; margin: 0; }

  table.slip { width: 100%; border-collapse: collapse; table-layout: fixed; }
  table.slip td { border: 0.75pt solid #000; padding: 3pt 6pt; height: 17pt; vertical-align: middle; overflow: hidden; }

  .nb { border: none !important; }
  .title { border: none; text-align: center; font-weight: bold; font-size: 13pt; letter-spacing: 0.4pt; padding: 2pt; }
  .subtitle { border: none; border-bottom: 1.5pt solid #000; text-align: center; font-weight: bold; font-size: 12pt; padding: 2pt 2pt 5pt; }

  .bold { font-weight: bold; }
  .ital { font-style: italic; }
  .sec { font-weight: bold; }
  .datecell { text-align: right; font-weight: bold; }

  .c-qty { text-align: right; font-variant-numeric: tabular-nums; }
  .c-rate { text-align: right; font-variant-numeric: tabular-nums; }
  .c-amt { text-align: right; font-variant-numeric: tabular-nums; }
  .c-unit { text-align: center; }
  .colon { text-align: center; }

  .sign-name { text-align: center; height: 48pt; vertical-align: bottom; padding-bottom: 4pt; }
  .sign-role { text-align: center; }

  .note {
    margin-top: 10pt; font-size: 9pt; color: #7a5b00;
    background: #fff7e0; border: 0.5pt solid #e6c766; padding: 5pt 8pt; border-radius: 3pt;
  }
</style>
</head>
<body>
  <table class="slip">
    <colgroup>
      <col style="width:16%" /><col style="width:20%" /><col style="width:10%" />
      <col style="width:8%" /><col style="width:23%" /><col style="width:23%" />
    </colgroup>
    <tbody>
      {{!-- Header --}}
      <tr><td colspan="6" class="title">{{company.name}}</td></tr>
      <tr><td colspan="6" class="subtitle">SLIP PEMBAYARAN GAJI</td></tr>
      <tr>
        <td class="nb"></td><td class="nb"></td><td class="nb"></td>
        <td class="nb"></td><td class="nb"></td>
        <td class="datecell">{{payDate}}</td>
      </tr>

      {{!-- Identitas --}}
      <tr><td>No.</td><td></td><td></td><td></td><td class="bold">{{slipNo}}</td><td></td></tr>
      <tr><td>Nama</td><td></td><td></td><td></td><td class="bold">{{worker.name}}</td><td></td></tr>

      {{!-- Harian --}}
      <tr><td class="sec">*) HARIAN</td><td></td><td></td><td></td><td></td><td></td></tr>
      {{#each harianRows}}
      <tr>
        <td></td><td></td>
        <td class="c-qty">{{this.qty}}</td>
        <td class="c-unit">{{this.unit}}</td>
        <td class="c-rate">{{this.rate}}</td>
        <td class="c-amt">{{this.amount}}</td>
      </tr>
      {{/each}}
      {{#unless harianRows.length}}
      <tr><td></td><td></td><td></td><td></td><td></td><td></td></tr>
      {{/unless}}

      {{!-- Lembur / pekerjaan tambahan --}}
      <tr><td class="sec">*) LEMBUR</td><td></td><td></td><td></td><td></td><td></td></tr>
      {{#each lemburRows}}
      <tr>
        <td>{{this.date}}</td>
        <td>{{this.desc}}</td>
        <td class="c-qty">{{this.qty}}</td>
        <td class="c-unit">{{this.unit}}</td>
        <td class="c-rate">{{this.rate}}</td>
        <td class="c-amt">{{this.amount}}</td>
      </tr>
      {{/each}}
      {{#unless lemburRows.length}}
      <tr><td></td><td></td><td></td><td></td><td></td><td></td></tr>
      {{/unless}}

      {{!-- Baris kosong pemisah (seperti sample) --}}
      {{#each fillerRows}}
      <tr><td></td><td></td><td></td><td></td><td></td><td></td></tr>
      {{/each}}

      {{!-- Ringkasan --}}
      <tr>
        <td></td><td></td><td></td><td></td>
        <td class="bold">Pendapatan Kotor</td>
        <td class="c-amt bold">{{grossFmt}}</td>
      </tr>
      <tr>
        <td>Potongan- potongan</td><td></td><td></td>
        <td class="colon">:</td>
        <td>Pinjaman/Kasbon</td>
        <td class="c-amt">{{advanceFmt}}</td>
      </tr>
      <tr>
        <td></td><td></td><td></td><td></td>
        <td>Tabungan</td>
        <td class="c-amt">{{deductionFmt}}</td>
      </tr>
      <tr>
        <td></td><td></td><td></td><td></td>
        <td class="bold">Pendapatan Bersih</td>
        <td class="c-amt bold">{{netFmt}}</td>
      </tr>

      {{!-- Saldo berjalan --}}
      <tr>
        <td class="bold ital">Saldo tabungan</td><td></td><td></td><td></td><td></td>
        <td class="c-amt">{{savingsBalanceFmt}}</td>
      </tr>
      <tr>
        <td class="bold ital">Sisa kasbon</td><td></td><td></td><td></td><td></td>
        <td class="c-amt">{{loanBalanceFmt}}</td>
      </tr>

      {{!-- Tanda tangan --}}
      <tr>
        <td colspan="3" class="sign-name">{{approver.name}}</td>
        <td colspan="3" class="sign-name">{{worker.name}}</td>
      </tr>
      <tr>
        <td colspan="3" class="sign-role">{{approver.roleLabel}}</td>
        <td colspan="3" class="sign-role">Penerima</td>
      </tr>
    </tbody>
  </table>

  {{#if pendingNote}}
  <div class="note">{{pendingNote}}</div>
  {{/if}}
</body>
</html>
